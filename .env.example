# 模板：复制为 .env 并填入真实值（占位值不可直接使用）。
# cp .env.example .env

# Postgres 初始化凭据（仅首次创建 pgdata 卷时生效）
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=app

# 本地开发必填：后端连接串（须与 POSTGRES_* 一致，端口 5432）。
# docker-compose.yml 在容器内用 POSTGRES_* 拼装等价的 @db:5432 地址。
DATABASE_URL=postgresql+psycopg://change-me:change-me-too@127.0.0.1:5432/app

# Redis（忘记密码验证码存储 + 限流；docker-compose 已含 redis 服务）
# 本地开发不使用 compose 时默认连 redis://127.0.0.1:6379/0
REDIS_URL=redis://redis:6379/0

# 管理员引导：服务启动时自动创建/升级 admin（幂等，admin 已存在时跳过）
# 也可手动：python -m app.create_admin（Docker：docker compose exec backend …）
# compose 会透传进 backend 容器；seed 的演示 admin 也优先读这两个值
ADMIN_EMAIL=change-me
ADMIN_PASSWORD=change-me-too

# 阿里云 DirectMail（忘记密码邮件；发信地址需在 DirectMail 控制台验证通过）
ALI_ACCESS_KEY_ID=change-me
ALI_ACCESS_KEY_SECRET=change-me-too
ALI_NO_REPLY_EMAIL=no-reply@your-domain.com
# 可选，默认 cn-hangzhou
# ALI_DM_REGION=cn-hangzhou

# 智谱 GLM API Key（学生 AI 总结功能，本地开发时后端直接读本文件）
GLM_API_KEY=
